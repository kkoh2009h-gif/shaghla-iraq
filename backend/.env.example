# Copy this file to .env in the backend runtime (never commit real values).
DATABASE_URL=sqlite:///./shaghla.db

# Generate a random secret with at least 32 characters.
SHAGHLA_AUTH_SECRET=replace-with-a-long-random-secret-value

# Configure a real SMS provider that accepts POST JSON { "to": "...", "message": "..." }
# and Authorization: Bearer <token>. No OTP is returned by the API.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
